# Set these as environment variables on your host. For a local run you can copy this to backend/.env and start with:
#   node --env-file=backend/.env --import tsx backend/api-server.ts
# (the server does not read .env files by itself). Never commit real values.

# Required in production. Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# They must be different from each other and at least 32 characters.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

NODE_ENV=production
PORT=5000

# Web origins allowed to call the API from a browser. Mobile apps send no Origin, so leave empty if mobile-only.
CORS_ORIGINS=

# How many reverse proxies sit in front of the API (Render/Railway/Heroku/nginx = 1), so rate limits see real client IPs.
TRUST_PROXY=1

# Development only (ignored when NODE_ENV=production): return the OTP in the /auth/otp/send response.
ALLOW_DEMO_OTP=false
