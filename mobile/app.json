{
  "expo": {
    "name": "India EV Finder",
    "slug": "india-ev-finder",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#020617"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.indiaevfinder.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#020617"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "INTERNET"
      ]
    },
    "web": {
      "bundler": "metro"
    }
  }
}
